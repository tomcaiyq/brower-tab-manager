{
  "manifest_version": 3,
  "name": "Tab Manager - 标签页管理器",
  "version": "1.0.0",
  "description": "高效管理浏览器标签页：搜索、分组、收藏、快速切换",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Tab Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
